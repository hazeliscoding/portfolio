{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/portfolio/browser",
  "routes": [
    {
      "src": "^/portfolio/pr-sweep/?$",
      "status": 307,
      "headers": { "Location": "https://github.com/hazeliscoding/pr-sweep" }
    },
    {
      "src": "^/portfolio/puzzle-boy/?$",
      "status": 307,
      "headers": { "Location": "https://github.com/hazeliscoding/puzzle-boy-community" }
    },
    { "src": "^/([^/\\\\].*)/$", "status": 308, "headers": { "Location": "/$1" } },
    {
      "src": "^/(chunk|main|polyfills|styles)-.*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "src": "^/blog/.+\\.md$", "headers": { "X-Robots-Tag": "noindex" }, "continue": true },
    {
      "src": "^/giscus-kairo\\.css$",
      "headers": { "Access-Control-Allow-Origin": "https://giscus.app" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "^/.*", "status": 404, "dest": "/404.html" }
  ]
}
